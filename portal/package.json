{
  "name": "monkflow-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MonkFlow client portal: sign-in, invitations and the signed-in console. Built by Vite into ../dist/portal and served by Vercel for /sign-in, /invite, /auth, /select-workspace, /dashboard and /demo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:site": "playwright test -c playwright.site.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.107.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.72.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
