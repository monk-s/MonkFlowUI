# ============================================
# BTC Trading Bot — Environment Variables
# ============================================
# Copy to .env and fill in your values.
# Only TRADING_MODE and DATABASE_URL are required for paper trading.

# --- Mode ---
TRADING_MODE=paper                # "paper" or "live"

# --- Database (Railway PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# --- Coinbase Advanced API (required for live trading) ---
CB_API_KEY=
CB_API_SECRET=
CB_API_PASSPHRASE=
CB_SANDBOX=false                  # true = sandbox (does NOT host BTC-PERP-INTX), false = production
SYMBOL=BTC-PERP-INTX             # Coinbase nano BTC perp symbol

# --- Risk Management (defaults are hardcoded, override only if needed) ---
# RISK_PER_TRADE_PCT=1.5
# MAX_RISK_PER_TRADE_PCT=2.0
# MIN_RR_RATIO=2.0
# MAX_PORTFOLIO_HEAT_PCT=5.0
# MAX_CONCURRENT_POSITIONS=2
# LEVERAGE=4.0

# --- Paper Trading ---
# PAPER_STARTING_BALANCE=10000.0

# --- v3 Grid Trader (defaults tuned for aggressive chop harvesting) ---
# BOT_ENGINE=grid                   # "grid" or "ema_trend" (legacy v1)
# GRID_PREBUY_PCT=70.0              # % of capital to lock as initial long
# GRID_NUM_LEVELS=30                # total price levels across the active range
# GRID_OPEN_ORDERS_PER_SIDE=10      # max open buys + max open sells at any time
# GRID_RECENTER_DAYS=14             # lookback window for range (tighter = more fills)
# GRID_RECENTER_INTERVAL_DAYS=14    # how often to rebuild the range
# GRID_RANGE_PADDING_PCT=5.0        # padding outside recent N-day range (lower = tighter)
# GRID_RECENTER_ON_RANGE_EXIT_PCT=2.0  # early recenter once price is >2% outside the range
#                                   # (0 disables — rely only on the time-based cadence)
# GRID_LONG_ONLY=true               # block sells that would push inventory below the floor
# GRID_INVENTORY_FLOOR_FRACTION=0.5 # floor = prebuy_qty * this. 0.5 lets the grid pre-place
#                                   # ~10 sells out of the box; 1.0 = legacy strict floor;
#                                   # 0.0 = no floor (grid can fully exit inventory).
# GRID_TICK_INTERVAL_SEC=30
# GRID_DD_CIRCUIT_BREAKER_PCT=40.0  # halt + close at -40% peak-to-trough equity DD

# --- Dashboard ---
PORT=8080                         # Railway assigns this automatically

# --- Logging ---
LOG_LEVEL=INFO
