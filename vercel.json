{
  "installCommand": "npm --prefix portal ci",
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/sprint", "destination": "/", "permanent": true },
    { "source": "/sprint.html", "destination": "/", "permanent": true },
    { "source": "/login", "destination": "/sign-in", "permanent": false },
    { "source": "/join", "destination": "/sign-in", "permanent": false }
  ],
  "headers": [
    {
      "source": "/portal/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(sign-in|invite|auth|select-workspace|dashboard|admin)(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://resourceful-abundance-production.up.railway.app/api/:path*"
    },
    { "source": "/sign-in", "destination": "/portal/index.html" },
    { "source": "/select-workspace", "destination": "/portal/index.html" },
    { "source": "/invite/:path*", "destination": "/portal/index.html" },
    { "source": "/auth/:path*", "destination": "/portal/index.html" },
    { "source": "/dashboard/:path*", "destination": "/portal/index.html" },
    {
      "source": "/(.*)",
      "destination": "/shell.html"
    }
  ]
}
