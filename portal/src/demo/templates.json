{
  "rent_roll": {
    "label": "Rent roll",
    "groups": [
      {
        "key": "property",
        "label": "Property"
      },
      {
        "key": "units",
        "label": "Units"
      },
      {
        "key": "totals",
        "label": "Totals"
      }
    ],
    "checks": [
      {
        "id": "rent_sum",
        "kind": "sum",
        "label": "Unit rents add up to the stated monthly total",
        "group": "units",
        "key": "rent",
        "equals": "totals.monthly_rent",
        "blocking": true
      },
      {
        "id": "occupancy",
        "kind": "ratio",
        "label": "Occupancy equals occupied units over total units",
        "top": "property.occupied_units",
        "bottom": "property.total_units",
        "equals": "property.occupancy",
        "blocking": false
      }
    ]
  },
  "t12": {
    "label": "T-12 statement",
    "groups": [
      {
        "key": "income",
        "label": "Income"
      },
      {
        "key": "expenses",
        "label": "Expenses"
      },
      {
        "key": "totals",
        "label": "Totals"
      }
    ],
    "checks": [
      {
        "id": "income_months",
        "kind": "rowsum",
        "label": "Each income line: twelve months add up to its annual figure",
        "group": "income",
        "keys": [
          "m1",
          "m2",
          "m3",
          "m4",
          "m5",
          "m6",
          "m7",
          "m8",
          "m9",
          "m10",
          "m11",
          "m12"
        ],
        "total": "annual",
        "blocking": true
      },
      {
        "id": "expense_months",
        "kind": "rowsum",
        "label": "Each expense line: twelve months add up to its annual figure",
        "group": "expenses",
        "keys": [
          "m1",
          "m2",
          "m3",
          "m4",
          "m5",
          "m6",
          "m7",
          "m8",
          "m9",
          "m10",
          "m11",
          "m12"
        ],
        "total": "annual",
        "blocking": true
      },
      {
        "id": "income_total",
        "kind": "sum",
        "label": "Income lines add up to total income",
        "group": "income",
        "key": "annual",
        "equals": "totals.total_income",
        "blocking": true
      },
      {
        "id": "expense_total",
        "kind": "sum",
        "label": "Expense lines add up to total expenses",
        "group": "expenses",
        "key": "annual",
        "equals": "totals.total_expenses",
        "blocking": true
      },
      {
        "id": "noi",
        "kind": "diff",
        "label": "NOI equals total income minus total expenses",
        "a": "totals.total_income",
        "b": "totals.total_expenses",
        "equals": "totals.noi",
        "blocking": true
      }
    ]
  },
  "financial_statement": {
    "label": "Personal financial statement",
    "groups": [
      {
        "key": "borrower",
        "label": "Borrower"
      },
      {
        "key": "assets",
        "label": "Assets"
      },
      {
        "key": "liabilities",
        "label": "Liabilities"
      },
      {
        "key": "totals",
        "label": "Totals"
      }
    ],
    "checks": [
      {
        "id": "assets",
        "kind": "sum",
        "label": "Asset lines add up to total assets",
        "group": "assets",
        "key": "amount",
        "equals": "totals.total_assets",
        "blocking": true
      },
      {
        "id": "liabilities",
        "kind": "sum",
        "label": "Liability lines add up to total liabilities",
        "group": "liabilities",
        "key": "amount",
        "equals": "totals.total_liabilities",
        "blocking": true
      },
      {
        "id": "net_worth",
        "kind": "diff",
        "label": "Net worth equals total assets minus total liabilities",
        "a": "totals.total_assets",
        "b": "totals.total_liabilities",
        "equals": "totals.net_worth",
        "blocking": true
      }
    ]
  },
  "subscription": {
    "label": "Subscription agreement",
    "groups": [
      {
        "key": "investor",
        "label": "Investor"
      },
      {
        "key": "commitments",
        "label": "Commitments"
      },
      {
        "key": "totals",
        "label": "Totals"
      }
    ],
    "checks": [
      {
        "id": "commitment",
        "kind": "sum",
        "label": "Commitments by class add up to the total commitment",
        "group": "commitments",
        "key": "amount",
        "equals": "totals.total_commitment",
        "blocking": true
      }
    ]
  }
}
