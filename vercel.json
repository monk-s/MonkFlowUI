{
  "redirects": [
    { "source": "/sprint", "destination": "/", "permanent": true },
    { "source": "/sprint.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://resourceful-abundance-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/shell.html"
    }
  ]
}
